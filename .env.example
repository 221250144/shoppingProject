# 环境变量示例（请复制为本地专用文件，不要提交真实凭据）
# 注意：Spring Boot 不会自动读取 .env 文件；请在运行环境中导出这些变量，或在 IDE 运行配置中设置。

# 应用端口（可选）
SERVER_PORT=8080

# 数据源配置（使用环境变量可覆盖 application.yml 内的同名配置）
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/shopping?useUnicode=true&characterEncoding=utf-8&useSSL=false
SPRING_DATASOURCE_USERNAME=your_mysql_user
SPRING_DATASOURCE_PASSWORD=your_mysql_password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# JPA/Hibernate（开发环境可使用 update，生产建议改为受控迁移）
SPRING_JPA_PROPERTIES_HIBERNATE_HBM2DDL_AUTO=update

# 文件上传目录（TODO：代码尚未支持该配置，仅作未来改造占位）
# FILE_UPLOAD_DIR=/absolute/path/to/static/images
